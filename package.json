{
  "name": "mezza",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config playwright.prod.config.ts",
    "test:e2e:smoke": "playwright test --config playwright.prod.config.ts --project=desktop tests/e2e/signup.spec.ts tests/e2e/service-flow.spec.ts tests/e2e/auth.spec.ts",
    "test:db": "supabase test db",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "db:check": "tsx scripts/db-check/run.ts",
    "seed": "tsx scripts/seed/index.ts",
    "seed:cloud": "tsx scripts/seed/index.ts --cloud",
    "seed:e2e": "tsx scripts/seed/e2e-workers.ts",
    "db:types": "supabase gen types typescript --local > src/lib/db/types.ts",
    "db:drift": "tsx scripts/db/drift-check.ts",
    "db:rollback-cycle": "tsx scripts/db/rollback-cycle.ts",
    "db:access-snapshot": "tsx scripts/db/access-snapshot.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm knip && pnpm format:check && pnpm test && pnpm test:db && pnpm build"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "exceljs": "^4.4.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "jsqr": "^1.4.0",
    "knip": "6.36.0",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.34.5"
}
