{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(supabase db push:*)",
      "Bash(npx supabase db push:*)",
      "Bash(pnpm supabase db push:*)",
      "Bash(pnpm exec supabase db push:*)",
      "Bash(pnpm dlx supabase db push:*)",
      "Bash(pnpm seed:cloud:*)",
      "Bash(pnpm run seed:cloud:*)",
      "Bash(npm run seed:cloud:*)",
      "Bash(tsx scripts/seed/index.ts --cloud:*)",
      "Bash(pnpm tsx scripts/seed/index.ts --cloud:*)",
      "Bash(npx tsx scripts/seed/index.ts --cloud:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin +main:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git push --force origin main:*)",
      "Bash(git push --force-with-lease origin main:*)",
      "Bash(git push -u origin main:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-edited-file.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
